# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
notes-app

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Local configuration files
config.local.yaml
config.dev.yaml

# IDE specific files
.vscode/
.idea/
*.swp
*.swo
*~

# OS specific files
.DS_Store
Thumbs.db

# Node.js / Playwright
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
playwright-report/
test-results/
playwright/.cache/
dist/

# Terraform - infra/ is applied manually by a human (`terraform apply`),
# never by CI. State is local; the plugin cache and state files are
# ignored, but .terraform.lock.hcl is intentionally committed (standard
# Terraform practice) so provider versions are reproducible.
infra/.terraform/
infra/terraform.tfstate*
infra/*.tfplan
infra/*.tfvars
